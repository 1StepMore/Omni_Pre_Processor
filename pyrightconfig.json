{
  "include": ["src"],
  "exclude": ["tests", "**/__pycache__"],
  "reportMissingTypeStubs": false,
  "reportDeprecated": false,
  "reportUnusedVariable": "warning",
  "reportUnusedImport": "warning",
  "reportMissingParameterType": "warning",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic"
}