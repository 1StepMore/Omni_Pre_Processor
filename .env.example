# OPP Environment Variables
# Copy this file to `.env` and edit values for your local install.
# `opp` does NOT auto-load this file (no dotenv dependency); export the
# variables in your shell or via your process manager (systemd, docker, etc.).

# --- MCP server (used by src/opp/mcp/config.py) ---
# Comma-separated list of directories the MCP server is allowed to read from.
OPP_MCP_ALLOWED_DIRS=/path/to/allowed
# Maximum file size (bytes) the MCP server will process. Default: 100 MiB.
OPP_MCP_MAX_FILE_SIZE=104857600
# Per-request timeout (seconds) for MCP tool calls. Default: 300.
OPP_MCP_TIMEOUT=300

# --- Config loader (Q-6: src/opp/config/__init__.py) ---
# Explicit path to a config file. Wins over config/default.yaml discovery.
OPP_CONFIG_PATH=/path/to/config.yaml

# --- OCR / ASR (used by src/opp/extractors/image_ocr.py) ---
# OCR engine: tesseract | rapidocr
OPP_OCR_ENGINE=tesseract
# OCR language hint (Tesseract traineddata tag, e.g. eng, chi_sim, chi_tra)
OPP_OCR_LANG=eng
# ASR engine for audio/video (whisper / faster-whisper)
OPP_ASR_ENGINE=whisper
# Whisper model size: tiny | base | small | medium | large
OPP_MODEL_SIZE=base

# --- CLI / cache ---
# Cache directory used by the CLI for transient artifacts.
OMNI_CACHE_DIR=$HOME/.omni_cache

# --- Logging ---
# Standard logging level name: DEBUG | INFO | WARNING | ERROR
OPP_LOG_LEVEL=INFO

# ===== MCP Server Configuration =====
# Variables read by src/opp/mcp/config.py and server.py.
# These control the OPP MCP server behavior.

# MCP server bind host and port (default: 127.0.0.1:8766)
# OPP_MCP_HOST=127.0.0.1
# OPP_MCP_PORT=8766

# Enable cleanup of MCP resource directory on shutdown (default: false)
# When true, recursively removes mcp_resources/ on SIGTERM/SIGINT/exit.
# OPP_MCP_CLEANUP_ON_SHUTDOWN=false

# Disable signal handlers in the MCP server (default: unset)
# Set to any value to disable.
# OPP_MCP_DISABLE_SIGNAL_HANDLERS=1

# CLI allowlist for --resource-dir guard (src/opp/cli.py:523).
# NOT read by the MCP server (which uses OPP_MCP_ALLOWED_DIRS).
# OPP_ALLOWED_DIRECTORIES=/path/to/docs,/path/to/output


# --- .env auto-loading (opt-in) ---
# Enable automatic .env file loading. Default: off.
# Set to 1 to enable. Or pass --load-dotenv to the CLI.
# Search path: $OPP_DOTENV → ./.env → walk parents → ~/.config/opp/.env
# OPP_AUTOLOAD_DOTENV=1

# ===== Shared MCP Infrastructure =====
# These env vars are shared across OPP, OL, and ORF MCP servers.

# Shared-secret auth for MCP requests. When set, all MCP tools require
# an auth_token parameter matching this value.
# MCP_SHARED_SECRET=your-shared-secret

# Log format: "console" (default) or "json"
# OMNI_LOG_FORMAT=console

# Prometheus metrics directory (default: /tmp/omni-metrics)
# OMNI_METRICS_DIR=/tmp/omni-metrics

# Health check endpoint configuration
# OMNI_HEALTH_HOST=127.0.0.1
# OMNI_HEALTH_PORT=8766
# OMNI_HEALTH_ENABLED=false

# Rate limiting (token bucket)
# OMNI_RATE_LIMIT_RPM=60
# OMNI_RATE_LIMIT_BURST=10

# OpenTelemetry tracing
# OMNI_TRACING_ENABLED=false
# OMNI_TRACING_DIR=/tmp/omni-traces
